                                        },
                                        {
                                          "tag": "blockquote",
                                          "text": "The following ambiguities will be resolved in the next step.",
                                          "children": []
                                        },
                                        {
                                          "tag": "ul",
                                          "children": [
                                            {
                                              "tag": "li",
                                              "text": "Refund handling when new fare is lower",
                                              "children": []
                                            },
                                            {
                                              "tag": "li",
                                              "text": "Eligibility for award-ticket bookings",
                                              "children": []
                                            },
                                            {
                                              "tag": "li",
                                              "text": "Behavior when companion-traveler bookings span tiers",
                                              "children": []
                                            },
                                            {
                                              "tag": "li",
                                              "text": "Whether change quotas reset on cancel-and-rebook",
                                              "children": []
                                            },
                                            {
                                              "tag": "li",
                                              "text": "Offline / poor-connection retry policy",
                                              "children": []
                                            }
