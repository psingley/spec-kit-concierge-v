                                        {
                                          "tag": "h1",
                                          "text": "Self-serve flight-change for loyalty guests",
                                          "children": []
                                        },
                                        {
                                          "tag": "h2",
                                          "text": "Problem",
                                          "children": []
                                        },
                                        {
                                          "tag": "p",
                                          "text": "Loyalty-tier guests currently must call the concierge desk to change a flight inside the ±48h departure window. This bottlenecks the desk during weather events ",
                                          "children": []
                                        },
                                        {
                                          "tag": "h2",
                                          "text": "Goals",
                                          "children": []
                                        },
                                        {
                                          "tag": "ul",
                                          "children": [
                                            {
                                              "tag": "li",
                                              "children": [
                                                {
                                                  "tag": "strong",
                                                  "text": "60%",
                                                  "children": []
                                                }
                                              ]
                                            },
                                            {
                                              "tag": "li",
                                              "children": [
                                                {
                                                  "tag": "strong",
                                                  "text": "<1.5s",
                                                  "children": []
                                                }
                                              ]
                                            },
                                            {
                                              "tag": "li",
                                              "children": [
                                                {
                                                  "tag": "strong",
                                                  "text": "under 0.5%",
                                                  "children": []
                                                }
                                              ]
                                            },
                                            {
                                              "tag": "li",
                                              "text": "No regression to existing supplier-side rebook contracts.",
                                              "children": []
                                            }
                                          ]
                                        },
                                        {
                                          "tag": "h2",
                                          "text": "Non-goals",
                                          "children": []
                                        },
                                        {
                                          "tag": "ul",
                                          "children": [
                                            {
                                              "tag": "li",
                                              "text": "New-bookings flow (out of scope).",
                                              "children": []
                                            },
                                            {
                                              "tag": "li",
                                              "text": "Multi-leg itineraries with >2 connecting flights.",
                                              "children": []
                                            },
                                            {
                                              "tag": "li",
                                              "text": "Loyalty-tier upgrades from inside the change flow.",
                                              "children": []
                                            }
                                          ]
                                        },
                                        {
                                          "tag": "h2",
                                          "text": "User stories",
                                          "children": []
                                        },
                                        {
                                          "tag": "ol",
                                          "children": [
                                            {
                                              "tag": "li",
                                              "text": "As a Gold-tier guest, I can open my itinerary and tap \"Change flight\" to see eligible alternatives.",
                                              "children": []
                                            },
                                            {
                                              "tag": "li",
                                              "children": [
                                                {
                                                  "tag": "strong",
                                                  "text": "and",
                                                  "children": []
                                                }
                                              ]
                                            },
                                            {
                                              "tag": "li",
                                              "text": "As an ops agent, I can see in the dashboard which self-serve changes hit the manual-review queue and why.",
                                              "children": []
                                            }
                                          ]
                                        },
                                        {
                                          "tag": "h2",
                                          "text": "Acceptance criteria",
                                          "children": []
                                        },
                                        {
                                          "tag": "ul",
                                          "children": [
                                            {
                                              "tag": "li",
                                              "text": "<span style=\"color:var(--text-faint)\">☐</span> Eligibility check runs in <200ms p95 against rebook-rules service.",
                                              "children": []
                                            },
                                            {
                                              "tag": "li",
                                              "text": "<span style=\"color:var(--text-faint)\">☐</span> Alternatives list is sorted by fare-difference, then departure delta.",
                                              "children": []
                                            },
                                            {
                                              "tag": "li",
                                              "children": [
                                                {
                                                  "tag": "strong",
                                                  "text": "and",
                                                  "children": []
                                                }
                                              ]
                                            },
                                            {
                                              "tag": "li",
                                              "text": "<span style=\"color:var(--text-faint)\">☐</span> Failed transactions roll back the itinerary-service write atomically.",
                                              "children": []
                                            },
                                            {
                                              "tag": "li",
                                              "text": "<span style=\"color:var(--text-faint)\">☐</span> Audit event is written to loyalty-ledger for every successful change.",
                                              "children": []
                                            }
                                          ]
